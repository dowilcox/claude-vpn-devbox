# Optional environment for the devbox container. Copy to devbox.env.
# Only uncomment what you use: a line left commented stays unset.

# Git identity for commits made in the container (its home isn't persisted).
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# GIT_COMMITTER_NAME=Your Name
# GIT_COMMITTER_EMAIL=you@example.com

# GitHub token for `gh` and HTTPS git push to github.com.
# GH_TOKEN=

# Long-lived Claude Code token from running `claude setup-token`.
# Without it, run `devbox claude` and use /login once; the login persists.
# CLAUDE_CODE_OAUTH_TOKEN=
