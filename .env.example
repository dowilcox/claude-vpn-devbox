# Copy to .env (or run `bin/devbox init`) and fill in.

# ---------------------------------------------------------------------------
# Projects
# ---------------------------------------------------------------------------
# Absolute path of the folder holding your projects. It is mounted at the same
# path inside the devbox.
PROJECTS_DIR=/home/you/code

# ---------------------------------------------------------------------------
# VPN (gluetun). Provider-specific settings:
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# Anything not listed here can go in an optional .env.vpn file, which is
# passed straight through to gluetun.
# ---------------------------------------------------------------------------
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
# OPENVPN_USER=
# OPENVPN_PASSWORD=
SERVER_COUNTRIES=
SERVER_CITIES=
TZ=UTC

# Subnets reachable WITHOUT the VPN. Keep Docker's range so host.docker.internal
# works. Append your LAN if you need it, e.g. 172.16.0.0/12,192.168.1.0/24
FIREWALL_OUTBOUND_SUBNETS=172.16.0.0/12

# ---------------------------------------------------------------------------
# Published ports (host side). Change any that clash with things on your host.
# Use 0.0.0.0 as BIND_ADDRESS to expose them on your LAN.
# ---------------------------------------------------------------------------
BIND_ADDRESS=127.0.0.1
HOST_PORT_3000=3000
HOST_PORT_5173=5173
HOST_PORT_8000=8000
HOST_PORT_8080=8080

# ---------------------------------------------------------------------------
# Devbox image
# ---------------------------------------------------------------------------
# Match your host user so files created in the container are owned by you.
DEVBOX_USER=dev
DEVBOX_UID=1000
DEVBOX_GID=1000

INSTALL_NODE=true
INSTALL_PYTHON=true
INSTALL_PHP=false
INSTALL_RUST=false
INSTALL_GO=false
INSTALL_DOCKER_CLI=true

# Git identity and tokens for the devbox go in devbox.env
# (copy devbox.env.example).

# ---------------------------------------------------------------------------
# Optional: drive the host Docker daemon from the devbox (root-equivalent!).
# Uncomment both lines to enable.
# ---------------------------------------------------------------------------
# COMPOSE_FILE=compose.yml:compose.docker.yml
# DOCKER_GID=   # stat -c %g /var/run/docker.sock
